{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext", "webworker"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/state": ["./src/engine/emptyPlayer.ts"],
      "@/*": ["./vendor/osrs-dps-calc/src/*"],
      "next/image": ["./src/shims/next-image.ts"],
      "axios": ["./src/shims/axios.ts"],
      "@jest/globals": ["./node_modules/vitest"]
    }
  },
  "include": ["src", "vendor/osrs-dps-calc/src", "tests", "scripts", "vite.config.ts"]
}
